# ==========================================
# EXPORTFLOW BY BENZWELL — CONFIGURATION
# ==========================================

# Application URLs
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Security
SESSION_SECRET=exportflow_super_secret_session_key_benzwell_2026_production

# Super Admin Provisioning (Initial Protected Bootstrap)
ADMIN_BOOTSTRAP_EMAIL=admin@benzwell.com
ADMIN_BOOTSTRAP_SECRET=BenzwellAdmin2026!SecureKey

# Appwrite Cloud Backend & Private Document Storage
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=exportflow_db
APPWRITE_BUCKET_ID=exportflow_documents

# ImageKit Public Branding & Logo Assets
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Resend Transactional Email Delivery
RESEND_API_KEY=
EMAIL_FROM="ExportFlow <notifications@exportflow.benzwell.com>"

# OpenRouter AI Engine
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
